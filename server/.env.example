PORT=4000
# Option 1: full Atlas URI with embedded credentials
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.efzi5kb.mongodb.net/<dbname>?retryWrites=true&w=majority

# Option 2: separate username/password for a local or custom host
# MONGODB_USERNAME=<username>
# MONGODB_PASSWORD=<password>
